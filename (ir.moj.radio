MOJ/
├── .github/workflows/
│   └── build-apk.yml                # ساخت خودکار و دستی APK
├── gradle/wrapper/
├── settings.gradle.kts
├── build.gradle.kts
└── app/
    ├── build.gradle.kts
    └── src/main/
        ├── AndroidManifest.xml
        ├── res/
        │   ├── drawable/
        │   │   ├── ic_launcher_background.xml
        │   │   ├── ic_launcher_foreground.xml
        │   │   └── ic_notification_moj.xml
        │   ├── mipmap-anydpi-v26/
        │   │   └── ic_launcher.xml
        │   └── values/
        │       └── themes.xml
        └── java/ir/moj/radio/
            ├── MojApplication.kt
            ├── MainActivity.kt
            ├── data/
            │   ├── UserPrefs.kt          # ذخیره نام مستعار و شناسه یکتا
            │   └── MeshModels.kt         # ساختار بسته‌ها و پیام‌ها
            ├── security/
            │   └── CryptoManager.kt      # رمزنگاری AES-256-GCM
            ├── network/
            │   ├── UdpDiscovery.kt       # کشف دستگاه‌ها در شبکه محلی
            │   ├── MeshRouter.kt         # مسیریابی Relay و جلوگیری از حلقه
            │   └── MemberManager.kt      # تأیید، رد و حذف اعضا
            ├── audio/
            │   └── PttAudioEngine.kt     # بی‌سیم Push To Talk + بوق پایان
            ├── file/
            │   └── ChunkFileTransfer.kt  # انتقال فایل تا ۱۵۰MB با Resume
            ├── camera/
            │   └── LocalCameraEngine.kt  # دوربین زنده محلی با رضایت کاربر
            ├── service/
            │   └── MojForegroundService.kt
            └── ui/
                ├── theme/Theme.kt
                ├── screens/
                │   ├── WelcomeScreen.kt
                │   ├── MainRadioScreen.kt
                │   ├── SettingsScreen.kt
                │   └── GuideScreen.kt
                └── components/
